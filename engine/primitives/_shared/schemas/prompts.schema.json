{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PromptsEnvelope",
  "type": "object",
  "required": ["schema_version", "primitive", "round", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "primitive": {"type": "string"},
    "round": {"type": "integer", "minimum": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "system", "user", "response_format", "model_tier"],
        "properties": {
          "id": {"type": "string"},
          "system": {"type": "string"},
          "user": {"type": "string"},
          "response_format": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {"enum": ["json", "text"]},
              "schema": {"type": "object"}
            }
          },
          "model_tier": {"enum": ["default", "deep"]}
        }
      }
    }
  }
}
