{# M6 /mod-synth-logs Phase C — database renderer body (M6-TEMPLATE-2 / #470).

   Renders the body of ``_render_database()``. Output line shape
   (per issue #470 acceptance):

       <timestamp> <program> <sql_kind SELECT|INSERT|UPDATE|DELETE> <table> <rows_affected> <duration_ms> <sqlcode>

   - ``program``: drawn from ``entities_digest["programs"]``.
   - ``sql_kind``: weighted choice — SELECT dominates (60%), INSERT 15%,
     UPDATE 15%, DELETE 10% — typical OLTP banking workload mix.
   - ``table``: drawn from ``entities_digest["files"]`` (VSAM file names
     double as DB2 table names on the mainframe; the M-tier spec treats
     ``files`` as the closed table catalog).
   - ``rows_affected``: ``rng.randint(0, 100)`` for SELECT/UPDATE/DELETE,
     ``1`` for INSERT.
   - ``duration_ms``: ``rng.randint(1, 250)`` typical OLTP latency.
   - ``sqlcode``: 99% ``0`` (success), 1% one of ``+100`` (NOTFND) or
     ``-803`` (DUPKEY) or ``-911`` (DEADLOCK).

   Anti-hallucination: empty programs or files lists produce empty
   output.
#}
from datetime import datetime, timedelta, timezone

programs = list(entities_digest.get("programs", []))
tables = list(entities_digest.get("files", []))
if not programs or not tables:
    return ""

window_start = datetime.fromisoformat(spec["time_range_start"])
window_end = datetime.fromisoformat(spec["time_range_end"])
entries_count = int(spec["entries_count"])
if entries_count <= 0:
    return ""

window_secs = max((window_end - window_start).total_seconds(), 1.0)
step = window_secs / max(entries_count, 1)

sql_kind_pool = ("SELECT",) * 12 + ("INSERT",) * 3 + ("UPDATE",) * 3 + ("DELETE",) * 2
sqlcode_error_pool = ("+100", "-803", "-911")
lines: list[str] = []
for i in range(entries_count):
    ts = window_start + timedelta(seconds=i * step)
    program = rng.choice(programs)
    sql_kind = rng.choice(sql_kind_pool)
    table = rng.choice(tables)
    if sql_kind == "INSERT":
        rows_affected = 1
    else:
        rows_affected = rng.randint(0, 100)
    duration_ms = rng.randint(1, 250)
    if rng.random() < 0.01:
        sqlcode = rng.choice(sqlcode_error_pool)
    else:
        sqlcode = "0"
    lines.append(
        f"{ts.replace(tzinfo=timezone.utc).isoformat()} "
        f"{program} {sql_kind} {table} {rows_affected} {duration_ms} {sqlcode}"
    )
return "\n".join(lines) + "\n"
